rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🌐 PUBLIC DATA (READ ONLY)
    // =========================

    match /board_of_trustees/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /members/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /supporters/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /advisory_volunteers/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mission/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /media_posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery_pics/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery_headings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /galleryFeed/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // 📄 CERTIFICATES (PUBLIC VERIFY)
    // =========================

    match /certificates/{certId} {
      allow read: if true; // QR verification
      allow write: if request.auth != null;
    }

    // =========================
    // 💼 CSR LEADS (PUBLIC SUBMIT)
    // =========================

    match /csr_partnerships/{docId} {
      allow create: if true;   // anyone can submit form
      allow read: if request.auth != null;  // only admin can view
      allow update, delete: if false;
    }

    // =========================
    // 📊 ANALYTICS (LIMITED PUBLIC WRITE)
    // =========================

    match /analytics/{document=**} {
      allow read, write: if true;
    }

    // =========================
    // 💰 DONATIONS (SECURE)
    // =========================

    match /donations/{docId} {
      allow create: if true;  // user payment entry
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // =========================
    // 🎓 EDUCATION APPLICATIONS
    // =========================

    match /applications/{docId} {
      allow create: if true;
      allow read: if request.auth != null || resource.data.status == 'approved';
      allow update, delete: if request.auth != null;
    }
    
    // =========================
    // 📝 ALL OTHER FORMS
    // =========================

    match /joinus_registrations/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /internship_applications/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /feedbacks/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /contest_entries/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /memberships/{docId} { allow create: if true; allow read, write: if request.auth != null; }

    // =========================
    // 🚫 DENY EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
