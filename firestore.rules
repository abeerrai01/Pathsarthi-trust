rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🌐 PUBLIC READ DATA
    // =========================

    match /board_of_trustees/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /members/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /supporters/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /advisory_volunteers/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mission/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /media_posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // 🖼️ GALLERY (FIXED)
    // =========================

    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /galleryFeed/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // 📄 CERTIFICATES (QR VERIFY)
    // =========================

    match /certificates/{certId} {
      allow read: if true; // public verification
      allow write: if request.auth != null;
    }

    // =========================
    // 🎓 STUDENT EDUCATION APPLICATIONS
    // =========================
    
    match /applications/{docId} {
      allow create: if true;
      allow read: if request.auth != null || (resource != null && resource.data.status == 'approved');
      allow update, delete: if request.auth != null;
    }

    // =========================
    // 💼 ALL PUBLIC FORMS
    // =========================

    match /csr_partnerships/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /donations/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /joinus_registrations/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /feedbacks/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /contest_entries/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /memberships/{docId} { allow create, read, update: if true; allow delete: if request.auth != null; }
    match /jan_sampark/{docId} { allow create, read, update: if true; allow delete: if request.auth != null; }
    match /queries/{docId} { allow create: if true; allow read, write: if request.auth != null; }

    // =========================
    // 📋 INTERNSHIP APPLICATIONS
    // Interns can read their own doc by matching credUid.
    // Credential fields (credEmail, credPassword, credUid, credActive) can only
    // be written by backend (Cloud Functions use admin SDK — bypasses these rules).
    // Public can create a new application.
    // =========================

    match /internship_applications/{docId} {
      // Public: submit new application
      allow create: if true;

      // Admin: full read/write
      allow read, write: if request.auth != null
        && (!('role' in request.auth.token) || request.auth.token.role != 'intern');

      // Intern: read only their own document
      allow read: if request.auth != null
        && ('role' in request.auth.token && request.auth.token.role == 'intern')
        && resource.data.credUid == request.auth.uid;

      // Intern: update ONLY the internTasks field in their own document
      // This allows task progress tracking without exposing credential fields.
      allow update: if request.auth != null
        && ('role' in request.auth.token && request.auth.token.role == 'intern')
        && resource.data.credUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['internTasks']);
    }

    // =========================
    // 🗂️ INTERN TASKS
    // Admin can create/update/delete tasks.
    // Interns can only read tasks assigned to their UID.
    // =========================

    match /intern_tasks/{taskId} {
      // Admin: full access
      allow read, write: if request.auth != null
        && (!('role' in request.auth.token) || request.auth.token.role != 'intern');

      // Intern: read only their own tasks
      allow read: if request.auth != null
        && ('role' in request.auth.token && request.auth.token.role == 'intern')
        && resource.data.internUid == request.auth.uid;
    }

    // =========================
    // 🏆 CERTIFICATE REQUESTS
    // Interns can create and read their own requests.
    // Admin can read/update all requests.
    // =========================

    match /certificate_requests/{certReqId} {
      // Intern: create a new request for themselves only
      allow create: if request.auth != null
        && ('role' in request.auth.token && request.auth.token.role == 'intern')
        && request.resource.data.internUid == request.auth.uid;

      // Intern: read only their own requests
      allow read: if request.auth != null
        && ('role' in request.auth.token && request.auth.token.role == 'intern')
        && resource.data.internUid == request.auth.uid;

      // Admin: full read/write
      allow read, write: if request.auth != null
        && (!('role' in request.auth.token) || request.auth.token.role != 'intern');
    }

    // =========================
    // 📊 ANALYTICS (OPEN)
    // =========================

    match /analytics/{document=**} {
      allow read, write: if true;
    }

    // =========================
    // 🚫 DENY EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

