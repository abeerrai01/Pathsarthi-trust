rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🌐 PUBLIC READ DATA
    // =========================

    match /board_of_trustees/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /members/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /supporters/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /advisory_volunteers/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mission/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /media_posts/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // 🖼️ GALLERY (FIXED)
    // =========================

    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /galleryFeed/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // =========================
    // 📄 CERTIFICATES (QR VERIFY)
    // =========================

    match /certificates/{certId} {
      allow read: if true; // public verification
      allow write: if request.auth != null;
    }

    // =========================
    // 🎓 STUDENT EDUCATION APPLICATIONS
    // =========================
    
    match /applications/{docId} {
      allow create: if true;
      allow read: if request.auth != null || (resource != null && resource.data.status == 'approved');
      allow update, delete: if request.auth != null;
    }

    // =========================
    // 💼 ALL PUBLIC FORMS
    // =========================

    match /csr_partnerships/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /donations/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /joinus_registrations/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /internship_applications/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /feedbacks/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /contest_entries/{docId} { allow create: if true; allow read, write: if request.auth != null; }
    match /memberships/{docId} { allow create: if true; allow read, write: if request.auth != null; }

    // =========================
    // 📊 ANALYTICS (OPEN)
    // =========================

    match /analytics/{document=**} {
      allow read, write: if true;
    }

    // =========================
    // 🚫 DENY EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
